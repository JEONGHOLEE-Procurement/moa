# MOA 환경변수 예시 — 복사해서 .env 로 저장하세요.
# .env 는 절대 커밋하지 마세요 (.gitignore에 포함됨).

# ── 인스타그램 실연동 (Instagram API with Instagram Login) ──
# Meta 개발자 앱에서 발급: https://developers.facebook.com/apps
IG_APP_ID=
IG_APP_SECRET=
# Meta 앱에 등록한 리디렉트 URI와 정확히 일치해야 함 (https 필수).
# 로컬 개발은 https 터널(ngrok 등)이 필요할 수 있음. 미설정 시 요청 origin에서 유추.
IG_REDIRECT_URI=

# 서버 포트 (기본 3500)
# PORT=3500
